{
  "name": "jarvis-support-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.7",
    "nodemailer": "^10.4.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
