# 복사해서 .env 로 저장한 뒤 값을 채워 주세요. (Prisma CLI는 .env만 읽어요 · .env는 git에 올라가지 않아요)

# ── 로컬 개발 (docker compose의 값과 같아야 함) ──
DATABASE_URL="postgresql://jarvis:jarvis_local_pw@localhost:5432/jarvis?schema=public"
DIRECT_URL="postgresql://jarvis:jarvis_local_pw@localhost:5432/jarvis?schema=public"

# ── 배포 서버 ──
# DATABASE_URL = 앱이 쓰는 PostgreSQL 주소 (커넥션 풀러가 있으면 그 주소)
# DIRECT_URL   = 마이그레이션용 직접 연결 주소 (풀러가 없으면 DATABASE_URL과 같은 값)

# 최초 관리자 계정 (seed 때만 사용, 코드·깃에 비밀번호를 남기지 않기 위함)
ADMIN_INITIAL_LOGIN_ID="admin"
ADMIN_INITIAL_PASSWORD="change-me-strong-password"

# 관리자 세션 쿠키 서명 키 (32자 이상 무작위 문자열)
SESSION_SECRET="change-me-32-characters-or-longer-secret"

# (선택) GitHub Actions → /api/releases/sync 인증 토큰
SYNC_SECRET="change-me"
# 설치 파일(.exe)이 올라가는 "앱 저장소"의 OWNER/REPO (이 사이트 저장소가 아님)
GITHUB_REPO="OWNER/REPO"

# 앱 저장소 GitHub webhook(Releases) 서명 키 — 32자 이상 무작위, webhook 설정의 Secret과 같은 값 (필수)
GITHUB_WEBHOOK_SECRET=""
# (선택) GitHub API 토큰 — 공개 저장소면 비워 둠. 있으면 API 호출 한도가 늘어남
GITHUB_TOKEN=""

# Cloudflare Turnstile (자동 등록 방지) — 개발에서는 둘 다 비우면 Cloudflare 테스트 키(항상 통과)를 씀
# 사이트 키는 공개 값(빌드 결과물에 들어감), 비밀 키는 서버 전용. 운영에서 비밀 키가 없으면 글 등록을 거부함
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 버그 신고 스크린샷 저장 폴더 (로컬 전용, 선택, 기본값: 프로젝트 폴더의 uploads/)
# Netlify 배포에서는 자동으로 Netlify Blobs에 저장하므로 넣지 않는다
UPLOAD_DIR=""

# 답변 알림 메일 (console | gmail | resend)
MAIL_PROVIDER="console"
GMAIL_USER="team-account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
RESEND_API_KEY=""
MAIL_FROM="비서 자비스 <noreply@your-domain.com>"
SITE_URL="http://localhost:3000"
